---
import settings from '../data/settings.json';
const path = Astro.url.pathname;
const pumpLinks = [
  { href: '/produkter/', label: 'Alla värmepumpar' },
  { href: '/produkter/#luft-luft', label: 'Luftvärmepumpar' },
  { href: '/produkter/#luft-vatten', label: 'Luft/vattenvärmepumpar' },
];
const links = [
  { href: '/energideklaration/', label: 'Energideklarationer' },
  { href: '/kontakt/?arende=Service och reparation', label: 'Service' },
  { href: '/om-oss/', label: 'Om oss' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href.split(/[?#]/)[0]));
const tel = settings.phone.replace(/[^\d+]/g, '');
const check = '<path d="M5 12.5l4.5 4.5L19 7.5"/>';
---
<div class="topbar">
  <div class="container topbar__inner">
    <ul class="topbar__list">
      {settings.topbar.map((t) => (
        <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={check} />{t}</li>
      ))}
    </ul>
    <div class="topbar__contact">
      {settings.location && (
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>{settings.location}</span>
      )}
      <a href={`tel:${tel}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>{settings.phone}</a>
    </div>
  </div>
</div>
<header class="header">
  <div class="container header__inner">
    <a href="/" class="logo">
      <img src="/images/site/logo.png" alt={settings.companyName} width="936" height="101" />
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Öppna meny" />
    <label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span></label>
    <nav class="nav">
      <div class="dropdown">
        <a href="/produkter/" class:list={['dropdown__toggle', { active: path.startsWith('/produkter') }]} aria-haspopup="true">
          Värmepumpar
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </a>
        <div class="dropdown__menu">
          {pumpLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      </div>
      {links.map((l) => (
        <a href={l.href} class:list={{ active: isActive(l.href) && !l.href.includes('?') }}>{l.label}</a>
      ))}
      <a href="/kontakt/" class="btn nav__cta">Kontakta oss</a>
    </nav>
  </div>
</header>

<style>
  svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; flex: none; }

  .topbar { background: var(--c-green); color: #fff; font-size: .8rem; font-weight: 500; }
  .topbar__inner { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .55rem 0; }
  .topbar__list { display: flex; gap: 1.75rem; list-style: none; margin: 0; padding: 0; }
  .topbar__list li, .topbar__contact > * { display: inline-flex; align-items: center; gap: .4rem; }
  .topbar__contact { display: flex; gap: 1.75rem; }
  .topbar a { color: #fff; text-decoration: none; font-weight: 600; }
  @media (max-width: 900px) { .topbar__list { display: none; } .topbar__inner { justify-content: center; } }
  @media (max-width: 420px) { .topbar__contact { gap: 1rem; } }

  .header { position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.96); backdrop-filter: blur(10px); border-bottom: 1px solid var(--c-border); }
  .header__inner { display: flex; align-items: center; justify-content: space-between; min-height: 74px; gap: 1.5rem; }
  .logo img { width: clamp(170px, 17vw, 210px); height: auto; }
  .nav { display: flex; align-items: center; gap: 1.9rem; font-size: .92rem; }
  .nav a:not(.btn) { color: var(--c-ink); text-decoration: none; font-weight: 500; }
  .nav a:not(.btn):hover, .nav a.active { color: var(--c-green); }
  .nav__cta { padding: .8rem 1.4rem; margin-left: .5rem; font-size: .92rem; }

  .dropdown { position: relative; }
  .dropdown__toggle { display: inline-flex; align-items: center; gap: .3rem; padding: .5rem 0; }
  .dropdown__menu { position: absolute; top: 100%; left: -1rem; min-width: 230px; padding: .5rem; background: #fff; border: 1px solid var(--c-border); border-radius: 12px; box-shadow: var(--shadow);
    opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity .15s, transform .15s, visibility .15s; }
  .dropdown__menu a { display: block; padding: .6rem .8rem; border-radius: 8px; }
  .dropdown__menu a:hover { background: var(--c-soft); }
  .dropdown:hover .dropdown__menu, .dropdown:focus-within .dropdown__menu { opacity: 1; visibility: visible; transform: none; }

  .nav-toggle, .nav-burger { display: none; }
  @media (max-width: 960px) {
    .nav-burger { display: block; width: 28px; height: 20px; position: relative; cursor: pointer; }
    .nav-burger span, .nav-burger::before, .nav-burger::after { content: ''; position: absolute; left: 0; right: 0; height: 2.5px; background: var(--c-ink); border-radius: 2px; }
    .nav-burger span { top: 9px; } .nav-burger::before { top: 0; } .nav-burger::after { bottom: 0; }
    .nav { display: none; position: absolute; top: 74px; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 0; background: #fff; border-bottom: 1px solid var(--c-border); padding: .5rem 1.25rem 1.25rem; font-size: 1rem; }
    .nav > a:not(.btn), .dropdown__toggle { padding: .9rem 0; border-bottom: 1px solid var(--c-border); }
    .dropdown__toggle { display: flex; }
    .dropdown__toggle svg { display: none; }
    .dropdown__menu { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; border: 0; padding: 0 0 0 1rem; min-width: 0; }
    .dropdown__menu a { padding: .7rem 0; border-bottom: 1px solid var(--c-border); border-radius: 0; color: var(--c-muted) !important; }
    .dropdown__menu a:first-child { display: none; }
    .nav__cta { margin: 1rem 0 0; justify-content: center; }
    .nav-toggle:checked ~ .nav { display: flex; }
  }
</style>

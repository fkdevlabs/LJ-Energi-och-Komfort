---
import settings from '../data/settings.json';
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Hem' },
  { href: '/produkter/', label: 'Värmepumpar' },
  { href: '/om-oss/', label: 'Om oss' },
  { href: '/kontakt/', label: 'Kontakt' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const tel = settings.phone.replace(/[^\d+]/g, '');
---
<div class="topbar">
  <div class="container topbar__inner">
    <span>★ Fast pris · Personlig rådgivning</span>
    <a href={`tel:${tel}`}>{settings.phone}</a>
  </div>
</div>
<header class="header">
  <div class="container header__inner">
    <a href="/" class="logo">
      <img src="/favicon.svg" alt="" width="36" height="36" />
      <span>{settings.companyName}</span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Öppna meny" />
    <label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span></label>
    <nav class="nav">
      {links.map((l) => (
        <a href={l.href} class:list={{ active: isActive(l.href) }}>{l.label}</a>
      ))}
      <a href="/kontakt/" class="btn nav__cta">Få offert</a>
    </nav>
  </div>
</header>

<style>
  .topbar { background: var(--c-green-deep); color: #e6f2ea; font-size: .85rem; }
  .topbar__inner { display: flex; justify-content: space-between; gap: 1rem; padding: .5rem 0; }
  .topbar a { color: var(--c-mint); font-weight: 600; text-decoration: none; }
  @media (max-width: 640px) { .topbar__inner span { display: none; } .topbar__inner { justify-content: center; } }

  .header { position: sticky; top: 0; z-index: 10; background: rgba(255,255,255,.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--c-border); }
  .header__inner { display: flex; align-items: center; justify-content: space-between; min-height: 76px; }
  .logo { display: flex; align-items: center; gap: .7rem; font: 700 1.2rem/1 var(--f-head); letter-spacing: -.01em; color: var(--c-ink); text-decoration: none; }
  .nav { display: flex; align-items: center; gap: 2rem; }
  .nav a:not(.btn) { color: var(--c-ink); text-decoration: none; font-weight: 500; position: relative; }
  .nav a:not(.btn)::after { content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 3px; border-radius: 2px; background: var(--c-green); transform: scaleX(0); transition: transform .2s; }
  .nav a.active::after, .nav a:not(.btn):hover::after { transform: scaleX(1); }
  .nav__cta { padding: .75rem 1.3rem; }
  .nav-toggle, .nav-burger { display: none; }
  @media (max-width: 860px) {
    .nav-burger { display: block; width: 28px; height: 20px; position: relative; cursor: pointer; }
    .nav-burger span, .nav-burger::before, .nav-burger::after { content: ''; position: absolute; left: 0; right: 0; height: 2.5px; background: var(--c-ink); border-radius: 2px; }
    .nav-burger span { top: 9px; } .nav-burger::before { top: 0; } .nav-burger::after { bottom: 0; }
    .nav { display: none; position: absolute; top: 76px; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 0; background: #fff; border-bottom: 1px solid var(--c-border); padding: .5rem 1.25rem 1.25rem; }
    .nav a:not(.btn) { padding: .9rem 0; border-bottom: 1px solid var(--c-border); }
    .nav a:not(.btn)::after { display: none; }
    .nav__cta { margin-top: 1rem; justify-content: center; }
    .nav-toggle:checked ~ .nav { display: flex; }
  }
</style>

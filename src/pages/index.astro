---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import settings from '../data/settings.json';

const featured = (await getCollection('products', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const { title, highlight } = settings.hero;
const [before, after] = highlight && title.includes(highlight) ? title.split(highlight) : [title, undefined];

const icons = [
  '<path d="M12 2l2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 14.3 7.2 16.9l.9-5.4L4.2 7.7l5.4-.8z"/>',
  '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8 12h8M12 8v8"/>',
  '<path d="M4 7h16M4 12h16M4 17h10"/>',
  '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17v3h3l5.3-5.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-.5-.5-2.5z"/>',
];
---
<Base>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <span class="hero__eyebrow">Försäljning · Rådgivning · Service</span>
        <h1>{before}{after !== undefined && <><mark>{highlight}</mark>{after}</>}</h1>
        <p class="hero__lead">{settings.hero.text}</p>
        <div class="hero__actions">
          <a href="/kontakt/" class="btn btn--light">{settings.hero.buttonText} →</a>
          <a href="/produkter/" class="btn btn--ghost">Se värmepumpar</a>
        </div>
        <dl class="hero__stats">
          {settings.stats.map((s) => <div><dt>{s.value}</dt><dd>{s.label}</dd></div>)}
        </dl>
      </div>
      <div class="hero__visual" aria-hidden="true">
        <div class="hero__blob"></div>
        <img src="/images/placeholder-heatpump.svg" alt="" width="400" height="300" />
      </div>
    </div>
  </section>

  <section class="section usps-wrap">
    <div class="container grid grid--4 usps">
      {settings.usps.map((u, i) => (
        <div class="usp">
          <span class="usp__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i % icons.length]} /></span>
          <h3>{u.title}</h3>
          <p>{u.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section__head">
        <div>
          <span class="eyebrow">Sortiment</span>
          <h2>Populära värmepumpar</h2>
        </div>
        <a href="/produkter/" class="btn btn--outline">Visa alla</a>
      </div>
      <div class="grid grid--3">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Enkelt från start till mål</span>
      <h2>Så går det till</h2>
      <ol class="steps">
        <li><b>Kontakta oss</b><span>Fyll i formuläret eller ring – vi återkommer inom 24 timmar.</span></li>
        <li><b>Rådgivning</b><span>Vi går igenom dina behov och rekommenderar rätt pump.</span></li>
        <li><b>Fast offert</b><span>Du får ett tydligt, fast pris på värmepumpen.</span></li>
        <li><b>Leverans</b><span>Vi levererar pumpen och finns kvar med service och support.</span></li>
      </ol>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container faq">
      <div>
        <span class="eyebrow">FAQ</span>
        <h2>Vanliga frågor</h2>
        <p class="lead">Hittar du inte svaret? Ring oss på <a href={`tel:${settings.phone.replace(/[^\d+]/g, '')}`}>{settings.phone}</a>.</p>
      </div>
      <div class="faq__list">
        {settings.faq.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container cta__inner">
      <div>
        <h2>Redo att sänka din elräkning?</h2>
        <p>Kostnadsfri offert – helt utan förpliktelser.</p>
      </div>
      <a href="/kontakt/" class="btn">{settings.hero.buttonText} →</a>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; color: #fff; background:
    radial-gradient(circle at 85% 20%, rgba(255,255,255,.12), transparent 40%),
    linear-gradient(135deg, var(--c-green-deep) 0%, var(--c-green-dark) 45%, var(--c-green) 100%); }
  .hero__inner { display: grid; gap: 3rem; grid-template-columns: 1.15fr 1fr; align-items: center; padding: clamp(3.5rem, 8vw, 6.5rem) 0; }
  @media (max-width: 480px) { .hero__eyebrow { font-size: .68rem; letter-spacing: .06em; } }
  .hero__eyebrow { display: inline-block; font-size: .8rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; padding: .45rem .9rem; border: 1px solid rgba(255,255,255,.3); border-radius: 999px; margin-bottom: 1.5rem; }
  .hero h1 { color: #fff; }
  .hero mark { background: none; color: var(--c-mint); }
  .hero__lead { font-size: 1.15rem; color: rgba(255,255,255,.85); max-width: 52ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .9rem; margin: 2rem 0 2.75rem; }
  .hero__stats { display: flex; gap: 2.5rem; margin: 0; padding-top: 1.75rem; border-top: 1px solid rgba(255,255,255,.2); }
  .hero__stats dt { font: 700 2rem/1 var(--f-head); color: var(--c-mint); }
  .hero__stats dd { margin: .35rem 0 0; font-size: .9rem; color: rgba(255,255,255,.75); }
  .hero__visual { position: relative; display: grid; place-items: center; }
  .hero__blob { position: absolute; width: 88%; aspect-ratio: 1; border-radius: 50%; background: rgba(255,255,255,.92); }
  .hero__visual img { position: relative; width: 100%; filter: drop-shadow(0 30px 40px rgba(0,0,0,.3)); }
  @media (max-width: 860px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__visual { max-width: 380px; margin-inline: auto; }
    .hero__stats { gap: 1.5rem; }
    .hero__stats dt { font-size: 1.6rem; }
  }

  .usps-wrap { padding-top: 4rem; }
  .usp__icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: #e3f4e9; color: var(--c-green); margin-bottom: 1.1rem; }
  .usp__icon svg { width: 26px; height: 26px; }
  .usp h3 { margin-bottom: .4rem; }
  .usp p { margin: 0; color: var(--c-muted); }

  .section__head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; flex-wrap: wrap; margin-bottom: 2.5rem; }
  .section__head h2 { margin: 0; }

  .steps { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; counter-reset: s; }
  .steps li { counter-increment: s; position: relative; display: flex; flex-direction: column; gap: .4rem; padding: 1.75rem; border-radius: var(--radius); background: var(--c-soft); }
  .steps li::before { content: '0' counter(s); font: 700 2.6rem/1 var(--f-head); color: var(--c-green); margin-bottom: .75rem; }
  .steps b { font: 700 1.2rem/1.2 var(--f-head); }
  .steps span { color: var(--c-muted); }

  .faq { display: grid; gap: 3rem; grid-template-columns: 1fr 1.4fr; align-items: start; }
  @media (max-width: 860px) { .faq { grid-template-columns: 1fr; } }
  .faq__list details { background: #fff; border: 1px solid var(--c-border); border-radius: 14px; padding: 1.15rem 1.4rem; margin-bottom: .75rem; transition: border-color .15s; }
  .faq__list details[open] { border-color: var(--c-green); }
  .faq__list summary { font-weight: 600; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  .faq__list summary::-webkit-details-marker { display: none; }
  .faq__list summary::after { content: '+'; font-size: 1.4rem; line-height: 1; color: var(--c-green); transition: transform .2s; }
  .faq__list details[open] summary::after { transform: rotate(45deg); }
  .faq__list p { margin: .75rem 0 0; color: var(--c-muted); }

  .cta { background: var(--c-soft); color: var(--c-ink); border-top: 1px solid var(--c-border); }
  .cta__inner { display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; padding: 3.5rem 0; }
  .cta h2 { margin: 0 0 .3rem; }
  .cta p { margin: 0; color: rgba(16,32,24,.7); }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import settings from '../data/settings.json';

const featured = (await getCollection('products', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---
<Base>
  <section class="hero">
    <div class="container hero__inner">
      <div>
        <h1>{settings.hero.title}</h1>
        <p class="lead">{settings.hero.text}</p>
        <div class="hero__actions">
          <a href="/kontakt/" class="btn">{settings.hero.buttonText}</a>
          <a href="/produkter/" class="btn btn--outline">Se våra värmepumpar</a>
        </div>
      </div>
      <img src="/images/placeholder-heatpump.svg" alt="Luftvärmepump" width="400" height="300" />
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--4">
      {settings.usps.map((u) => (
        <div class="usp">
          <h3>{u.title}</h3>
          <p>{u.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section__head">
        <h2>Populära värmepumpar</h2>
        <a href="/produkter/">Visa alla →</a>
      </div>
      <div class="grid grid--3">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container steps">
      <h2>Så går det till</h2>
      <ol class="grid grid--4">
        <li><b>Kontakta oss</b><span>Fyll i formuläret eller ring – vi återkommer inom 24 timmar.</span></li>
        <li><b>Platsbesök</b><span>Vi går igenom huset och rekommenderar rätt pump.</span></li>
        <li><b>Fast offert</b><span>Du får ett fast pris inklusive installation och ROT-avdrag.</span></li>
        <li><b>Installation</b><span>Certifierade installatörer monterar och tar pumpen i drift.</span></li>
      </ol>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container faq">
      <h2>Vanliga frågor</h2>
      {settings.faq.map((f) => (
        <details>
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section cta">
    <div class="container">
      <h2>Redo att sänka din elräkning?</h2>
      <p class="lead">Kostnadsfri offert – helt utan förpliktelser.</p>
      <a href="/kontakt/" class="btn">{settings.hero.buttonText}</a>
    </div>
  </section>
</Base>

<style>
  .hero { background: linear-gradient(135deg, #e8f1f8, #fff); padding: 4.5rem 0; }
  .hero__inner { display: grid; gap: 2.5rem; grid-template-columns: 1.2fr 1fr; align-items: center; }
  .hero__inner img { border-radius: var(--radius); box-shadow: var(--shadow); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.5rem; }
  @media (max-width: 820px) { .hero__inner { grid-template-columns: 1fr; } }
  .usp h3 { font-size: 1.1rem; color: var(--c-primary); }
  .usp p { margin: 0; color: var(--c-muted); }
  .section__head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.5rem; }
  .steps ol { list-style: none; padding: 0; counter-reset: s; }
  .steps li { counter-increment: s; display: flex; flex-direction: column; gap: .3rem; }
  .steps li::before { content: counter(s); width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--c-primary); color: #fff; display: grid; place-items: center; font-weight: 700; margin-bottom: .4rem; }
  .steps span { color: var(--c-muted); }
  .faq { max-width: 800px; }
  .faq details { background: #fff; border: 1px solid var(--c-border); border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: .75rem; }
  .faq summary { font-weight: 600; cursor: pointer; }
  .faq p { margin: .75rem 0 0; color: var(--c-muted); }
  .cta { text-align: center; background: var(--c-primary); color: #fff; }
  .cta .lead { color: #d6e6f1; }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import settings from '../data/settings.json';
import { uspIcons as icons, steps } from '../lib';
import '../styles/home.css';

const featured = (await getCollection('products', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const { title, highlight } = settings.hero;
const [before, after] = highlight && title.includes(highlight) ? title.split(highlight) : [title, undefined];

---
<Base>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        {settings.hero.eyebrow && <span class="hero__eyebrow">{settings.hero.eyebrow}</span>}
        <h1>{before}{after !== undefined && <><mark>{highlight}</mark>{after}</>}</h1>
        <p class="hero__lead">{settings.hero.text}</p>
        <div class="hero__actions">
          <a href="/kontakt/" class="btn btn--light">{settings.hero.buttonText} →</a>
          <a href="/energideklaration/" class="btn btn--ghost">Energideklaration</a>
        </div>
        <dl class="hero__stats">
          {settings.stats.map((s) => <div><dt>{s.value}</dt><dd>{s.label}</dd></div>)}
        </dl>
      </div>
      <div class="hero__visual" aria-hidden="true">
        <div class="hero__blob"></div>
        <img src="/images/placeholder-heatpump.svg" alt="" width="400" height="300" />
      </div>
    </div>
  </section>

  <section class="section usps-wrap">
    <div class="container grid grid--4 usps">
      {settings.usps.map((u, i) => (
        <div class="usp">
          <span class="usp__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i % icons.length]} /></span>
          <h3>{u.title}</h3>
          <p>{u.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">{settings.declaration.title}</span>
      <h2>Ska du bygga, sälja eller köpa?</h2>
      <p class="lead">{settings.declaration.intro}</p>
      <div class="grid grid--3 cases">
        {settings.declaration.cases.map((c) => (
          <a href={`/energideklaration/#${c.id}`} class="card case">
            <img src={c.image} alt="" loading="lazy" width="460" height="300" />
            <div class="case__body">
              <h3>{c.title}</h3>
              <p>{c.text}</p>
              <span class="case__more">Läs mer →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section__head">
        <div>
          <span class="eyebrow">Sortiment</span>
          <h2>Populära värmepumpar</h2>
        </div>
        <a href="/produkter/" class="btn btn--outline">Visa alla</a>
      </div>
      <div class="grid grid--3">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Enkelt från start till mål</span>
      <h2>Så går det till</h2>
      <ol class="steps">
        {steps.map((s) => <li><b>{s.title}</b><span>{s.text}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container faq">
      <div>
        <span class="eyebrow">FAQ</span>
        <h2>Vanliga frågor</h2>
        <p class="lead">Hittar du inte svaret? Ring oss på <a href={`tel:${settings.phone.replace(/[^\d+]/g, '')}`}>{settings.phone}</a>.</p>
      </div>
      <div class="faq__list">
        {settings.faq.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container cta__inner">
      <div>
        <h2>Har du frågor eller vill boka oss?</h2>
        <p>Fyll i formuläret eller ring oss på {settings.phone}.</p>
      </div>
      <a href="/kontakt/" class="btn">{settings.hero.buttonText} →</a>
    </div>
  </section>
</Base>


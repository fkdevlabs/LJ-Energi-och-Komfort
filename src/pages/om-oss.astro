---
import Base from '../layouts/Base.astro';
import settings from '../data/settings.json';
---
<Base title="Om oss">
  <section class="section">
    <div class="container prose">
      <h1>Om {settings.companyName}</h1>
      <p class="lead">Vi är ett lokalt företag som hjälper villaägare att sänka sina energikostnader med moderna värmepumpar.</p>
      <p>Vi hjälper dig hela vägen – från rådgivning och val av rätt värmepump till leverans, garanti och service.</p>
      <p>{settings.serviceArea}.</p>
      <p><a href="/kontakt/" class="btn">Kontakta oss</a></p>
    </div>
  </section>
</Base>

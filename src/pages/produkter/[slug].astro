---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatPrice } from '../../lib';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

const { product } = Astro.props;
const p = product.data;
const { Content } = await render(product);

const specs = [
  ['Typ', p.type],
  ['Märke', p.brand],
  ['Energiklass', p.energyClass],
  ['SCOP', p.scop],
  ['Värmeeffekt', p.heatingCapacity],
  ['Passar för', p.suitableFor],
  ['Fungerar ner till', p.minOutdoorTemp !== undefined ? `${p.minOutdoorTemp} °C` : undefined],
  ['Ljudnivå inomhus', p.noiseLevel !== undefined ? `${p.noiseLevel} dB(A)` : undefined],
].filter(([, v]) => v !== undefined && v !== '');
---
<Base title={p.title} description={p.excerpt}>
  <section class="section">
    <div class="container">
      <a href="/produkter/" class="back">← Alla värmepumpar</a>
      <div class="detail">
        <img src={p.image} alt={p.title} width="600" height="450" class="card" />
        <div>
          <span class="badge">{p.type}</span>
          {p.campaignPrice && <span class="badge badge--sale">Kampanj</span>}
          <h1>{p.title}</h1>
          <p class="lead">{p.excerpt}</p>
          <div class="price">
            {p.campaignPrice ? (
              <><s>{formatPrice(p.price)}</s> <strong>{formatPrice(p.campaignPrice)}</strong></>
            ) : (
              <strong>{formatPrice(p.price)}</strong>
            )}
            <small>inkl. standardinstallation, efter ROT-avdrag</small>
          </div>
          <p class={p.inStock ? 'stock stock--yes' : 'stock stock--no'}>
            {p.inStock ? '● I lager – installation inom kort' : '● Beställningsvara'}
          </p>
          {p.features.length > 0 && (
            <ul class="features">{p.features.map((f) => <li>{f}</li>)}</ul>
          )}
          <a href={`/kontakt/?produkt=${product.id}`} class="btn">Begär offert på {p.title}</a>
        </div>
      </div>

      <div class="detail__more">
        <div class="prose"><Content /></div>
        <table class="specs card">
          <caption>Teknisk data</caption>
          <tbody>
            {specs.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>

<style>
  .back { display: inline-block; margin-bottom: 1.5rem; text-decoration: none; }
  .detail { display: grid; gap: 2.5rem; grid-template-columns: 1fr 1fr; align-items: start; }
  .detail img { width: 100%; background: var(--c-soft); }
  .detail h1 { margin-top: .75rem; }
  .detail .badge + .badge { margin-left: .4rem; }
  .price { display: flex; flex-direction: column; margin: 1rem 0; }
  .price strong { font-size: 2rem; color: var(--c-primary); }
  .price s, .price small { color: var(--c-muted); }
  .stock { font-weight: 600; }
  .stock--yes { color: #1e8a4c; } .stock--no { color: #a35f00; }
  .features { padding-left: 1.2rem; margin-bottom: 1.5rem; }
  .detail__more { display: grid; gap: 2.5rem; grid-template-columns: 1.4fr 1fr; margin-top: 3rem; align-items: start; }
  .specs { border-collapse: collapse; width: 100%; overflow: hidden; }
  .specs caption { text-align: left; font-weight: 700; padding: 0 0 .5rem; }
  .specs th, .specs td { padding: .7rem 1rem; text-align: left; border-bottom: 1px solid var(--c-border); }
  .specs th { color: var(--c-muted); font-weight: 500; width: 45%; }
  @media (max-width: 820px) { .detail, .detail__more { grid-template-columns: 1fr; } }
</style>

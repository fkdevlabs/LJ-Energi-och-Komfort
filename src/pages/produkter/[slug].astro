---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatPrice } from '../../lib';
import '../../styles/product.css';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

const { product } = Astro.props;
const p = product.data;
const { Content } = await render(product);

const specs = [
  ['Typ', p.type],
  ['Märke', p.brand],
  ['Energiklass', p.energyClass],
  ['SCOP', p.scop],
  ['Värmeeffekt', p.heatingCapacity],
  ['Passar för', p.suitableFor],
  ['Fungerar ner till', p.minOutdoorTemp !== undefined ? `${p.minOutdoorTemp} °C` : undefined],
  ['Ljudnivå inomhus', p.noiseLevel !== undefined ? `${p.noiseLevel} dB(A)` : undefined],
].filter(([, v]) => v !== undefined && v !== '');
---
<Base title={p.title} description={p.excerpt}>
  <section class="section">
    <div class="container">
      <a href="/produkter/" class="back">← Alla värmepumpar</a>
      <div class="detail">
        <img src={p.image} alt={p.title} width="600" height="450" class="card" />
        <div>
          <span class="badge">{p.type}</span>
          {p.campaignPrice && <span class="badge badge--sale">Kampanj</span>}
          <h1>{p.title}</h1>
          <p class="lead">{p.excerpt}</p>
          <div class="price">
            {p.campaignPrice ? (
              <><s>{formatPrice(p.price)}</s> <strong>{formatPrice(p.campaignPrice)}</strong></>
            ) : (
              <strong>{formatPrice(p.price)}</strong>
            )}
            <small>inkl. moms</small>
          </div>
          <p class={p.inStock ? 'stock stock--yes' : 'stock stock--no'}>
            {p.inStock ? '● I lager – snabb leverans' : '● Beställningsvara'}
          </p>
          {p.features.length > 0 && (
            <ul class="features">{p.features.map((f) => <li>{f}</li>)}</ul>
          )}
          <a href={`/kontakt/?produkt=${product.id}`} class="btn">Begär offert på {p.title}</a>
        </div>
      </div>

      <div class="detail__more">
        <div class="prose"><Content /></div>
        <div>
        <h2 class="specs__title">Teknisk data</h2>
        <table class="specs card">
          <tbody>
            {specs.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}
          </tbody>
        </table>
        </div>
      </div>
    </div>
  </section>
</Base>

